<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AssemblyName>RimLLM Framework.Tests</AssemblyName>
    <FrameworkAssembly Condition="'$(FrameworkAssembly)' == ''">../Assemblies/RimLLM Framework.dll</FrameworkAssembly>
    <NoWarn>MSB3277;SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Bcl.AsyncInterfaces"><HintPath>../Assemblies/Microsoft.Bcl.AsyncInterfaces.dll</HintPath><Aliases>bclasync</Aliases></Reference>
    <Reference Include="System.Threading.Tasks.Extensions"><HintPath>../Assemblies/System.Threading.Tasks.Extensions.dll</HintPath><Aliases>ste</Aliases></Reference>
    <Reference Include="RimLLM Framework"><HintPath>$(FrameworkAssembly)</HintPath></Reference>
    <Reference Include="../Assemblies/*.dll" Exclude="../Assemblies/RimLLM Framework.dll;../Assemblies/System.Threading.Tasks.Extensions.dll;../Assemblies/Microsoft.Bcl.AsyncInterfaces.dll" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="netstandard"><HintPath>$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8\Facades\netstandard.dll</HintPath></Reference>
  </ItemGroup>
</Project>
