<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Source/RimLLM Framework/Core/Security/*.cs" Link="KeyStore/%(Filename)%(Extension)" />
    <Reference Include="System.Security.Cryptography.ProtectedData">
      <HintPath>$(MSBuildToolsPath)/System.Security.Cryptography.ProtectedData.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
