<Project>
  <Target Name="CheckRimWorldReferences" BeforeTargets="ResolveAssemblyReferences">
    <!-- RimWorld API 參考組件改由 Krafs.Rimworld.Ref NuGet 套件提供；此處僅檢查 Harmony 與測試執行期所需的遊戲 DLL。 -->
    <Error Condition="!Exists('$(HarmonyDll)')" Text="Harmony 1.7 assembly not found. Set HarmonyDll or WorkshopDir." />
    <Error Condition="!Exists('$(RimWorldDir)Assembly-CSharp.dll')" Text="RimWorld 1.7 game assemblies not found (needed for test runtime). Set RimWorldDir (or RIMWORLD_DIR) to the game root directory." />
  </Target>
</Project>
