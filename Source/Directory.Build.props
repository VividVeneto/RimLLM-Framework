<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <!-- 預設為安裝在 RimWorld/Mods 下的工作樹；其他位置請指定 RimWorldDir。 -->
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RIMWORLD_DIR)' != ''">$(RIMWORLD_DIR)</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\</RimWorldDir>
    <RimWorldDir>$([MSBuild]::EnsureTrailingSlash('$(RimWorldDir)'))</RimWorldDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == '' and '$(WORKSHOP_DIR)' != ''">$(WORKSHOP_DIR)</WorkshopDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">$(RimWorldDir)..\..\workshop\content\294100\</WorkshopDir>
    <WorkshopDir>$([MSBuild]::EnsureTrailingSlash('$(WorkshopDir)'))</WorkshopDir>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">$(WorkshopDir)2009463077\1.7\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>
</Project>
